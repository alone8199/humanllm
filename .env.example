# ============================================================================
# HumanLLM environment configuration (copy to .env and adjust)
# ============================================================================

# ----- Database -----
# Local/dev (zero deps): sqlite+aiosqlite:///./humanllm.db
# Docker compose:       postgresql+asyncpg://humanllm:humanllm@db:5432/humanllm
DATABASE_URL=sqlite+aiosqlite:///./humanllm.db

# ----- Queue broker -----
# auto | memory | redis
# Local/dev: memory   (in-process asyncio queues)
# Docker:     redis   (set REDIS_URL below)
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ----- Storage -----
# local | s3
# Local/dev: local    (files saved under ./storage)
# Docker:     s3      (MinIO / S3-compatible)
STORAGE_BACKEND=local

# S3 / MinIO (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=humanllm
S3_SECRET_KEY=humanllm123
S3_BUCKET=humanllm
S3_REGION=us-east-1

# ----- Security -----
# IMPORTANT: use a long random string (>=32 bytes) in production.
JWT_SECRET=change-me-in-production
# Base URL exposed to workers for file content links (optional in local mode)
PUBLIC_BASE_URL=http://localhost:8000

# ----- Dispatch / billing -----
# Auto-assign task to least-busy online worker (true) or grab-only (false).
AUTO_ASSIGN=true
# Seconds a task waits for a human before timing out and refunding.
TASK_TIMEOUT_SECONDS=600
# Platform commission fraction taken from each completed task's charge.
COMMISSION_RATE=0.15

# ----- Seed (idempotent; safe to leave defaults) -----
# Single shared default password for ALL seeded accounts (admin, worker, demo).
DEFAULT_PASSWORD=admin123
SEED_API_KEY=sk-humanllm-demo-key-0001
SEED_WORKER_USERNAME=worker1
SEED_WORKER_PASSWORD=admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ----- Frontend (used by docker-compose nginx) -----
BACKEND_HOST=backend
BACKEND_PORT=8000
